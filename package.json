{
  "name": "@surfex-ai/sdk",
  "version": "0.1.0",
  "description": "Agentic browser automation library with vision and self-healing",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./playwright": {
      "types": "./dist/drivers/PlaywrightDriver.d.ts",
      "import": "./dist/drivers/PlaywrightDriver.mjs",
      "require": "./dist/drivers/PlaywrightDriver.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/drivers/PlaywrightDriver.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts src/drivers/PlaywrightDriver.ts --format cjs,esm --dts --watch",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "browser",
    "agent",
    "llm",
    "automation",
    "playwright"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.0.0",
    "playwright": "^1.60.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.78",
    "@ai-sdk/openai": "^3.0.64",
    "ai": "^6.0.183",
    "zod": "^3.23.0"
  }
}
